{
  "uid": "gateway-overview",
  "title": "Gateway overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Active requests", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "targets": [{"expr": "gateway_active", "refId": "A"}]},
    {"id": 2, "type": "timeseries", "title": "Requests per second", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "targets": [{"expr": "rate(gateway_accepted_total[1m])", "legendFormat": "accepted", "refId": "A"}, {"expr": "rate(gateway_rejected_total[1m])", "legendFormat": "rejected", "refId": "B"}]},
    {"id": 3, "type": "timeseries", "title": "Upstream errors per second", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "targets": [{"expr": "rate(gateway_upstream_errors_total[1m])", "refId": "A"}]}
  ]
}
